// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum SubscriptionStatus {
  free
  pro
}

enum QuestionType {
  single
}

enum MediaKind {
  image
}

/**
 * Autodecks
 */
enum DeckAutoType {
  FLAGGED
  WRONG
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  name            String
  surname         String
  passwordHash    String
  role            Role      @default(user)
  createdAt       DateTime  @default(now())

  // Subscription Management
  subscriptionStatus    SubscriptionStatus @default(free)
  subscriptionId        String?            @unique
  subscriptionExpiresAt DateTime?
  dailyQuestionsUsed    Int                @default(0)
  lastQuestionResetAt   DateTime           @default(now())

  // 7-Tage-Pro-Trial (ohne Kreditkarte). Nur einmal pro User aktivierbar.
  proTrialStartedAt DateTime?
  proTrialEndsAt    DateTime?

  // Onboarding-Profil (für personalisierte Presets & Empfehlungen)
  examTarget            String? // z. B. "M2", "Hammerexamen", "Z1"
  semester              Int?
  onboardingCompletedAt DateTime?

  // UI-Präferenzen
  fontScale String @default("normal") // "small" | "normal" | "large"

  // Pro-Zeit aus Empfehlungen und Einmalkäufen (Examenspass). Unabhängig vom
  // Stripe-Abo: läuft ein Bonus, ist der Nutzer Pro, auch ohne Abo.
  proBonusUntil DateTime?

  // Empfehlungsprogramm: eigener Code zum Weitergeben, wer einen geworben hat,
  // und ob die Belohnung schon gutgeschrieben wurde (erst nach E-Mail-Bestätigung).
  referralCode       String?   @unique
  referredById       String?
  referralRewardedAt DateTime?
  // Creator-Code, mit dem sich der Nutzer registriert hat (Medfluencer-Zuordnung).
  creatorCodeId      String?

  // Lernerinnerungen per E-Mail — nur nach ausdrücklicher Einwilligung (§ 7 UWG).
  reminderOptIn  Boolean   @default(false)
  reminderToken  String?   @unique
  lastReminderAt DateTime?
  // Tagesziel in Fragen.
  dailyGoal      Int       @default(30)

  purchases     Purchase[]
  attempts      Attempt[]
  emailTokens   EmailVerification[]
  PasswordReset PasswordReset[]
  questionStats UserQuestionStat[]
  questionStars QuestionStar[]

  // Gegenrelationen
  flags                UserQuestionFlag[]
  decks                Deck[]
  reviews              ReviewItem[]
  srSetting            SRUserSetting?
  subscription         Subscription?
  generatorDailyUsages GeneratorDailyUsage[]
  streak               UserStreak?
  generatorPresets     GeneratorPreset[]
  feedbacks            UserFeedback[]
  savedQuestions       SavedQuestion[]
  aiUsage              AiUsageEvent[]
  events               ProductEvent[]
  poolAnswers          PoolAnswer[]
  poolSeen             PoolSeen[]
  sessions             UserSession[]
  referredBy           User?                 @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            User[]                @relation("Referrals")
  creatorCode          CreatorCode?          @relation(fields: [creatorCodeId], references: [id], onDelete: SetNull)
}

model Exam {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  title                  String
  description            String
  priceCents             Int?
  isPublished            Boolean  @default(false)
  /// Wenn false: Prüfung erscheint nicht auf der öffentlichen Übersicht /exams (Inhalte unverändert).
  visibleOnExamsPage     Boolean  @default(true)
  /// Wenn true: Start-Popup (Konfiguration) wird übersprungen, Start öffnet direkt alle Fragen.
  disableStartPopup      Boolean  @default(false)
  /// Genau eine Prüfung als kostenloses Probedeck: nur für Nicht-Pro sichtbar, ohne Abo startbar.
  isFreeTrialDemo        Boolean  @default(false)
  passPercent            Int      @default(60)
  allowImmediateFeedback Boolean  @default(false)
  createdAt              DateTime @default(now())

  stripeProductId String? @unique
  stripePriceId   String? @unique

  // Kategorie-Zuordnung
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sections   Section[]
  questions  Question[]
  purchases  Purchase[]
  attempts   Attempt[]
  cases      QuestionCase[]
  globalTags ExamGlobalTag[] // Globale Tags für alle Fragen dieses Examens
}

model Section {
  id     String @id @default(cuid())
  examId String
  title  String
  order  Int

  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([examId, order])
}

model Question {
  id                          String       @id @default(cuid())
  examId                      String
  sectionId                   String?
  type                        QuestionType @default(single)
  stem                        String
  explanation                 String?
  hasImmediateFeedbackAllowed Boolean      @default(false)
  order                       Int          @default(0)

  caseId String?
  case   QuestionCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  exam              Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  section           Section?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  options           AnswerOption[]
  media             QuestionMedia[]
  answers           AttemptAnswer[]
  userStats         UserQuestionStat[]
  stars             QuestionStar[]
  attemptSelections AttemptQuestion[]

  // Gegenrelationen
  flags       UserQuestionFlag[]
  tags        QuestionTag[]
  deckItems   DeckItem[]
  reviewItems ReviewItem[]

  @@index([examId, order])
  @@index([examId, caseId])
}

model AnswerOption {
  id          String  @id @default(cuid())
  questionId  String
  text        String
  isCorrect   Boolean @default(false)
  explanation String?
  order       Int     @default(0)

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chosenIn AttemptAnswer[] @relation("AnswerOption_ChosenIn")

  @@index([questionId])
  @@index([questionId, order])
}

model Attempt {
  id           String    @id @default(cuid())
  userId       String
  examId       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  scorePercent Int?
  passed       Boolean?
  elapsedSec   Int       @default(0)

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam              Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers           AttemptAnswer[]
  selectedQuestions AttemptQuestion[]
}

model AttemptQuestion {
  id         String @id @default(cuid())
  attemptId  String
  questionId String
  order      Int    @default(0)

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId, order])
  @@index([questionId])
}

model AttemptAnswer {
  id             String  @id @default(cuid())
  attemptId      String
  questionId     String
  answerOptionId String
  isCorrect      Boolean

  attempt      Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerOption AnswerOption @relation("AnswerOption_ChosenIn", fields: [answerOptionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId], map: "AttemptAnswer_attemptId_questionId_key")
  @@index([answerOptionId])
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  examId          String
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
}

model LabValue {
  id       String @id @default(cuid())
  name     String
  refRange String
  unit     String
  category String
}

model MediaAsset {
  id         String    @id @default(cuid())
  url        String    @unique
  kind       MediaKind
  alt        String?
  thumbUrl   String?
  dataBase64 String?
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime  @default(now())

  usedIn QuestionMedia[]
}

model QuestionMedia {
  questionId String
  mediaId    String
  order      Int    @default(0)

  question Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([questionId, mediaId])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  newEmail   String?
  code       String
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
  @@index([userId, newEmail, code])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, token])
}

model QuestionCase {
  id       String  @id @default(cuid())
  examId   String
  vignette String?

  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([examId])
}

model ExamGlobalTag {
  id     String @id @default(cuid())
  examId String
  tagId  String

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([examId, tagId])
  @@index([examId])
  @@index([tagId])
}

model UserQuestionStat {
  userId        String
  questionId    String
  seenCount     Int       @default(0)
  wrongCount    Int       @default(0)
  lastWrongAt   DateTime?
  lastCorrectAt DateTime?
  updatedAt     DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([questionId])
  @@index([lastWrongAt])
}

model UserQuestionFlag {
  userId     String
  questionId String
  flaggedAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([questionId])
}

model QuestionStar {
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([questionId])
}

/**
 * ============ Tags ============
 */
model Tag {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  parentId String?
  parent   Tag?    @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Tag[]   @relation("TagHierarchy")

  questionLinks  QuestionTag[]
  examGlobalTags ExamGlobalTag[]

  @@index([parentId])
}

model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
}

/**
 * ============ Decks (explizite Pivot) ============
 */
model Deck {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isAuto   Boolean       @default(false)
  autoType DeckAutoType?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     DeckItem[]
  srSetting SRDeckSetting?

  // genau 1 Deck pro (userId, autoType); mehrere mit NULL (normale Decks) sind erlaubt
  @@unique([userId, autoType])
  @@index([userId])
}

model DeckItem {
  deckId     String
  questionId String
  order      Int      @default(0)
  addedAt    DateTime @default(now())

  deck     Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // sorgt dafür, dass upsert({ where: { deckId_questionId: {…}}}) funktioniert
  @@id([deckId, questionId])
  @@index([questionId])
}

/**
 * ======= Spaced Repetition =======
 */
model ReviewItem {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  dueAt      DateTime
  interval   Int      @default(1)
  ease       Float    @default(2.5)
  lapses     Int      @default(0)
  suspended  Boolean  @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([dueAt])
}

/// ======= Spaced Repetition Settings =======

model SRUserSetting {
  userId        String   @id
  newPerDay     Int      @default(20)
  reviewsPerDay Int      @default(200)
  startEase     Float    @default(2.5)
  easeMin       Float    @default(1.3)
  easeMax       Float    @default(2.7)
  learningSteps Json? // z.B. [1,3,7] in Tagen
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SRDeckSetting {
  deckId        String   @id
  srEnabled     Boolean  @default(false)
  // Optional: overrides; wenn NULL -> user global
  newPerDay     Int?
  reviewsPerDay Int?
  startEase     Float?
  learningSteps Json?
  suspended     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String? // Hex-Farbe für UI
  order       Int      @default(0) // Sortierreihenfolge
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams Exam[] // Prüfungen in dieser Kategorie
}

/**
 * ============ Subscription Management ============
 */
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(free)
  priceId              String? // Stripe Price ID
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model GeneratorDailyUsage {
  id        String   @id @default(cuid())
  userId    String?
  anonKey   String?
  ipHash    String?
  dayKey    String
  count     Int      @default(0)
  /// Aus dem Pool ausgelieferte Fragen (billig, eigenes Kontingent).
  poolCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@unique([anonKey, dayKey])
  @@unique([ipHash, dayKey])
  @@index([dayKey])
}

/**
 * ============ Streaks (Daily-Login-Gamification) ============
 */
model UserStreak {
  userId            String   @id
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  /// Berlin-Tageskey (YYYY-MM-DD) der letzten Aktivität.
  lastActiveDayKey  String?
  /// Wievielmal hat der User schon eine 7-/30-Tage-Marke erreicht?
  milestonesReached Int      @default(0)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * ============ Generator-Presets (speichern & teilen) ============
 */
model GeneratorPreset {
  id                String   @id @default(cuid())
  userId            String
  title             String
  topic             String
  difficulty        Int      @default(3)
  mode              String   @default("single") // "single" | "case"
  caseQuestionCount Int?
  /// Optionaler Public-Slug für Teil-Links (ohne Login einsehbar).
  publicSlug        String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([publicSlug])
}

/**
 * ============ User-Feedback (in-App-Widget) ============
 */
model UserFeedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  category  String   @default("general") // "bug" | "idea" | "praise" | "general"
  message   String
  pageUrl   String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

/**
 * ============ Kündigungen nach § 312k BGB ============
 * § 312k BGB verlangt eine ohne Anmeldung erreichbare Kündigungsmöglichkeit
 * und eine Bestätigung der Kündigungserklärung in Textform unter Angabe von
 * Datum und Uhrzeit des Zugangs. Jede über /kuendigung abgegebene Erklärung
 * wird daher revisionssicher protokolliert — unabhängig davon, ob zur
 * angegebenen E-Mail-Adresse ein Abo gefunden wurde.
 */
model CancellationRequest {
  id String @id @default(cuid())

  /// Vom Erklärenden angegebene E-Mail-Adresse (Vertragszuordnung).
  email         String
  /// Optionale Selbstbezeichnung des Erklärenden.
  name          String?
  /// Eindeutige Bezeichnung des Vertrags (§ 312k Abs. 2 S. 3 Nr. 2 BGB).
  contractLabel String  @default("Pro-Abonnement fragenkreuzen.de")
  /// "ordentlich" | "ausserordentlich"
  kind          String  @default("ordentlich")
  /// Grund — bei außerordentlicher Kündigung erforderlich.
  reason        String?
  /// Gewünschter Beendigungszeitpunkt als Freitext.
  desiredDate   String?

  /// Verknüpftes Konto, sofern zur E-Mail eines gefunden wurde.
  userId String?

  /// Zugangszeitpunkt der Erklärung — maßgeblich für die Frist.
  receivedAt DateTime @default(now())
  /// Gehashte IP + User-Agent als Nachweis, ohne Klartext-PII zu speichern.
  ipHash     String?
  userAgent  String?

  /// "received" | "applied" | "no_subscription" | "failed"
  status      String    @default("received")
  processedAt DateTime?
  note        String?

  @@index([email])
  @@index([receivedAt])
  @@index([status])
}

/**
 * Idempotenz-Log für Stripe-Webhook-Events. Vor dem Anwenden eines Events
 * wird hier per `eventId` geprüft, ob das Event schon verarbeitet wurde.
 */
model StripeEventLog {
  id          String    @id @default(cuid())
  eventId     String    @unique
  type        String
  livemode    Boolean   @default(false)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([type])
  @@index([receivedAt])
}

/// Eine vom Generator erzeugte und für einen Nutzer gespeicherte Frage.
///
/// Bewusst getrennt von `Question`: Jenes Modell verlangt eine `examId` und
/// gehört zum kuratierten Prüfungsbestand. Generierte Fragen dort einzuhängen
/// würde Admin-Ansichten, Decks und Auswertungen des Bestands verfälschen.
///
/// Die vollständige Frage liegt als JSON in `payload` (Struktur: BulkQuestion).
/// Die daneben stehenden Spalten sind bewusst denormalisiert, damit Listen,
/// Fälligkeiten und Themenauswertung ohne JSON-Zugriff abfragbar bleiben.
///
/// Löschung: `onDelete: Cascade` — mit dem Konto verschwinden die Fragen.
model SavedQuestion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Herkunft aus dem gemeinsamen Pool — verhindert doppelte Ablage derselben Frage.
  poolQuestionId String?

  /// Fasst die Teilfragen EINER Fallfrage zusammen.
  groupId      String
  orderInGroup Int    @default(0)

  topic       String
  difficulty  Int
  mode        String  @default("single")
  section     String  @default("auto")
  sourceLabel String?
  /// Fragestellung, damit Listen ohne JSON-Parsing auskommen.
  stem        String

  /// Vollständige Frage inkl. Optionen, Erklärungen und Falltext.
  payload Json

  // ---- Lernstand ----
  attempts       Int       @default(0)
  correctCount   Int       @default(0)
  /// Richtige Antworten in Folge — steuert den Wiederholungsabstand.
  streak         Int       @default(0)
  lastAnsweredAt DateTime?
  lastCorrect    Boolean?
  /// Nächste Fälligkeit zur Wiederholung. null = noch nie beantwortet.
  dueAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, poolQuestionId])
  @@index([userId, createdAt])
  @@index([userId, dueAt])
  @@index([userId, lastCorrect])
  @@index([userId, topic])
  @@index([groupId])
}

/// Token-Verbrauch jedes KI-Aufrufs. Grundlage für "Kosten pro Frage".
/// Gespeichert werden Tokens, nicht Euro: Preise ändern sich und werden erst
/// in der Auswertung angewandt (siehe lib/ai-usage.ts).
model AiUsageEvent {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  /// draft | enrich | repair | review | exclusion | deepdive | assistant
  purpose         String
  model           String
  inputTokens     Int      @default(0)
  cachedTokens    Int      @default(0)
  outputTokens    Int      @default(0)
  reasoningTokens Int      @default(0)
  durationMs      Int      @default(0)
  ok              Boolean  @default(true)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([purpose, createdAt])
}

/// Produktereignisse für Retention, Nutzung und Conversion. Serverseitig,
/// ohne Drittanbieter. Ereignisse anonymer Besucher tragen keine Kennung.
model ProductEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  props     Json?

  @@index([name, createdAt])
  @@index([userId, createdAt])
}

/// Gemeinsamer Fragenpool. Jede vollständig erzeugte und geprüfte Frage wird
/// hier abgelegt und an alle Nutzer mit passendem Thema und Stufe ausgeliefert,
/// die sie noch nicht gesehen haben. Enthält keine personenbezogenen Daten.
model PoolQuestion {
  id            String   @id @default(cuid())
  /// Normalisiertes Thema (Kleinschreibung, ohne Satzzeichen) für die Suche.
  topicKey      String
  topic         String
  difficulty    Int
  section       String   @default("auto")
  stem          String
  /// Vollständige Frage (BulkQuestion) inkl. Kurzerklärungen.
  payload       Json
  /// Ausführliche Vertiefung — erst bei Bedarf erzeugt und dann für alle gespeichert.
  deepDive      String?
  contentHash   String   @unique
  /// active | retired
  status        String   @default("active")
  retiredReason String?
  servedCount   Int      @default(0)
  answeredCount Int      @default(0)
  correctCount  Int      @default(0)
  reportCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  answers PoolAnswer[]
  seen    PoolSeen[]

  @@index([topicKey, difficulty, status])
  @@index([status, createdAt])
}

/// Eine Antwort auf eine Poolfrage — Grundlage für Lösungsquote und Trennschärfe.
model PoolAnswer {
  id             String       @id @default(cuid())
  poolQuestionId String
  poolQuestion   PoolQuestion @relation(fields: [poolQuestionId], references: [id], onDelete: Cascade)
  /// Bei Kontolöschung bleibt die Antwort anonym für die Fragenstatistik erhalten.
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  correct        Boolean
  chosenIndex    Int
  msToAnswer     Int?
  /// Trefferquote des Antwortenden zum Zeitpunkt der Antwort (für die Trennschärfe).
  userAccuracy   Float?
  createdAt      DateTime     @default(now())

  @@index([poolQuestionId])
  @@index([userId, createdAt])
}

/// Welche Poolfragen ein angemeldeter Nutzer schon gesehen hat.
model PoolSeen {
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  poolQuestionId String
  poolQuestion   PoolQuestion @relation(fields: [poolQuestionId], references: [id], onDelete: Cascade)
  seenAt         DateTime     @default(now())

  @@id([userId, poolQuestionId])
  @@index([userId, seenAt])
}

/// Aktive Anmeldungen. Begrenzt gleichzeitige Sitzungen pro Konto.
model UserSession {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Creator-Codes für Medfluencer: Zuordnung von Registrierungen und Abos.
model CreatorCode {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  email             String?
  commissionPercent Int      @default(20)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  users             User[]
}
